# deploy/ai/.env — the inference host only. Copy to .env and edit.
#
# This file configures the GPU box. The Laravel application is configured
# separately, in backend/.env (LOCAL_AI_*).

# REQUIRED. Shared secret the web server sends as a bearer token. A private
# network is not an authorisation boundary: anything that reaches this port
# can spend the campus's whole inference capacity and read every prompt.
# Generate one: openssl rand -hex 32
VLLM_API_KEY=

# The private address this host is reached on FROM THE WEB SERVER.
# Loopback by default so a firewall mistake cannot publish an
# unauthenticated GPU. Never 0.0.0.0.
VLLM_BIND=127.0.0.1
VLLM_PORT=8000

# Model. Qwen/Qwen3.5-9B is the instruct-tuned release (Qwen3.5-9B-Base is
# the base model and must NOT be used). Revision is pinned so a silently
# updated checkpoint cannot invalidate the evaluation numbers.
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a

# The name Laravel asks for. Keep it stable across checkpoint changes so
# swapping weights is not an application deploy.
VLLM_SERVED_NAME=arucad-ask

# Quantisation. See README §3.
#   fp8    quantised on load, no preparation, ~9 GB weights   <- default
#   ""     BF16 as published, ~18 GB, little KV cache left
#   (W4A16 is selected by pointing VLLM_MODEL at a prepared
#    compressed-tensors checkpoint; it needs no flag here.)
VLLM_QUANTIZATION=fp8

# Context window. Sized to what the application actually sends, not to the
# model's maximum: a larger window costs KV cache per concurrent request.
VLLM_MAX_MODEL_LEN=16384

# Concurrency and memory headroom.
VLLM_GPU_UTIL=0.90
VLLM_MAX_SEQS=16

# vLLM worker IPC needs far more than Docker's 64 MB default.
VLLM_SHM_SIZE=8gb

# Only needed for gated repositories. Qwen3.5-9B is not gated.
# HF_TOKEN=

# Pinned image. Change deliberately, then re-run `php artisan ask:eval`.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0-cu129

# First start downloads ~20 GB and then quantises; later starts are quick.
VLLM_START_PERIOD=15m
