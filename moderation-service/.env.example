QWEN_ENABLED=true
QWEN_REQUIRED=true
QWEN_BASE_URL=http://qwen-guard:8000/v1
QWEN_MODEL=Qwen/Qwen3Guard-Gen-0.6B
QWEN_TIMEOUT_SECONDS=8

PII_ENABLED=true
STRICT_PII_BLOCK=false

NSFW_ENABLED=true
NSFW_REQUIRED=false
NSFW_BASE_URL=http://opennsfw2:8000
NSFW_BLOCK_THRESHOLD=0.88

OCR_ENABLED=false
OCR_REQUIRED=false
WHISPER_ENABLED=false
WHISPER_REQUIRED=false

URLHAUS_ENABLED=true
URLHAUS_REQUIRED=false
URLHAUS_FILE=data/urlhaus.txt

IMAGE_MAX_BYTES=12582912
VIDEO_MAX_BYTES=104857600
IMAGE_MAX_PIXELS=50000000
VIDEO_MAX_SECONDS=180
VIDEO_FRAME_COUNT=5
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
RULES_FILE=policies/rules.yml
