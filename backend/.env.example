# APP_URL=https://staging-api.example.com
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# QUEUE_CONNECTION=database
# CACHE_STORE=database
