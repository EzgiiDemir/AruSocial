APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Kept outside backend/ in ../sql/ on purpose — see sql/README.md. Resolved
# relative to backend/ (run `php artisan` from there, as documented).
DB_DATABASE=../sql/database.sqlite

# PostgreSQL is opt-in (local/CI/staging/production). Do not uncomment these
# as the default — `php artisan test` and local serve stay on SQLite.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=arucad
# DB_USERNAME=arucad
# DB_PASSWORD=
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_COOKIE=  # default: {app}-{APP_ENV}-session

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILESYSTEM_MEDIA_DISK=local
# MEDIA_URL=  # defaults to APP_URL; set if media is served from another origin
QUEUE_CONNECTION=database

# Laravel Reverb (Pusher protocol). APP_KEY is public (Flutter dart-define).
# APP_SECRET stays on the server — never put it in the client, query strings,
# logs, or event payloads. Placeholders only; rotate before any shared env.
REVERB_APP_ID=1001
REVERB_APP_KEY=arucad-local-key
REVERB_APP_SECRET=arucad-local-secret
REVERB_HOST=127.0.0.1
# 8080 is often blocked on Windows (Hyper-V excluded range). Local default is 8091.
REVERB_PORT=8091
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8091

CACHE_STORE=database
# CACHE_PREFIX=  # default: {app}-{APP_ENV}-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=  # default: {app}-{APP_ENV}-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated list of allowed web origins for CORS (see config/cors.php).
# Outside production, any localhost / 127.0.0.1 port is already accepted by
# pattern, so `flutter run -d chrome` (random port each launch) needs no
# entry here — this list is for everything else, e.g. a real web host.
# Native Android/iOS is never affected either way (P3-7 §5) — CORS only
# applies to browsers. Staging/production must set this to their real web
# origin(s) and never "*"; EnvironmentGuard refuses to boot otherwise
# (P3-7 §18, see app/Support/EnvironmentGuard.php).
CORS_ALLOWED_ORIGINS=http://localhost:8090

# Reverse proxy trust (P3-7 §13). Empty = trust no proxy, so X-Forwarded-*
# headers are ignored and REMOTE_ADDR/scheme come straight from the actual
# TCP connection — correct for local `php artisan serve` and safe as a
# default anywhere. Set to the proxy's IP(s) (comma-separated) once there is
# one in front of Laravel, or "*" to trust whichever host connected (only
# sane when Laravel is never reachable except through that proxy).
TRUSTED_PROXIES=

# Which accounts may open a session at all (POST /api/v1/auth/session).
# Enforced server-side, so a modified client can't sign in with an outside
# address the way it could when the check lived only in the Flutter app.
# Prefer AUTH_ALLOWED_EMAIL_DOMAINS (comma-separated). Singular key is kept
# for BC and for seeders that build student@/admin@/trainer@ addresses.
AUTH_ALLOWED_EMAIL_DOMAIN=@arucad.edu.tr
AUTH_ALLOWED_EMAIL_DOMAINS=@arucad.edu.tr,@gmail.com

# Local real-mail smoke (Gmail App Password required):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your-sending-gmail@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM_ADDRESS=your-sending-gmail@gmail.com
# MAIL_FROM_NAME=ARUVERSE
# AUTH_ALLOWED_EMAIL_DOMAINS=@arucad.edu.tr,@gmail.com
# TEST_STUDENT_EMAIL=ezgdemr02@gmail.com
# TEST_TRAINER_EMAIL=ezgidemir825@gmail.com

# Firebase Cloud Messaging (server). Leave empty to skip delivery; inbox
# rows are still written. Never put these in the Flutter app or git.
# FIREBASE_PRIVATE_KEY is the PEM; use \n for newlines in a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_REQUIRED=false

# Sentry (P3-6). Empty here is intentional — sentry/sentry-laravel no-ops
# without a DSN, so local dev never reports anything. Public DSN only
# (never the org auth/API token). Same var name the Flutter app reads via
# --dart-define=SENTRY_DSN (see frontend/lib/app/config/app_config.dart).
SENTRY_DSN=
# Optional: 0.0-1.0, unset/null disables performance tracing entirely
# (crash/error observability only in this milestone — see config/sentry.php).
# SENTRY_TRACES_SAMPLE_RATE=

# ---------------------------------------------------------------------------
# Directions (OSRM). TWO graphs, both from the Cyprus OSM extract, which
# covers the whole island including the TRNC — see deploy/osrm/README.md.
#
# An OSRM instance serves ONE profile and will happily answer
# /route/v1/driving/ from a pedestrian graph, so the graph is chosen by
# HOST, not by the profile in the URL:
#
#   ROUTING_BASE_URL          foot.lua graph  → walking routes
#   ROUTING_DRIVING_BASE_URL  car.lua  graph  → car and bus routes
#
# With deploy/docker-compose.yml (`--profile routing`) these are the
# service names on the compose network. Set BOTH; a mode whose graph is
# missing returns 501 ROUTING_NOT_CONFIGURED and the app draws an honest
# straight-line estimate. A vehicle is never routed over the pedestrian
# graph, because that produced real-looking routes down stairs and paths
# no car can use.
#
# ROUTING_BASE_URL=http://osrm-foot:5000
# ROUTING_DRIVING_BASE_URL=http://osrm-car:5000
#
# From the host (published ports) rather than inside the compose network:
# ROUTING_BASE_URL=http://127.0.0.1:5000
# ROUTING_DRIVING_BASE_URL=http://127.0.0.1:5001
#
# Local Windows: PHP may fail TLS verify (cURL 60). Set false only for local.
# ROUTING_VERIFY_SSL=false
#
# No OSRM of your own? The public demo (driving-only) can stand in for
# quick local work. It is a third party, so it is opt-in and must never be
# a production dependency.
# ROUTING_BASE_URL=https://router.project-osrm.org
# ROUTING_ALLOW_PUBLIC_FALLBACK=true
# ---------------------------------------------------------------------------

# Server-enforced check-in geofence (meters). Client GPS is advisory only.
# CHECKIN_RADIUS_METERS=150
# CHECKIN_CAMPUS_RADIUS_METERS=3000
# polygon (default) = site envelopes; radius = 3 km circles
# CHECKIN_GEOFENCE_MODE=polygon
# CHECKIN_COOLDOWN_MINUTES=30

# Live map crowd counts. How close a passive location ping must be to a
# building before the map counts that person as being there. Ghost-mode
# accounts are never recorded regardless of this value.
# PRESENCE_RADIUS_METERS=75

# FEED_REQUIRE_APPROVAL=  # empty: true in production, false otherwise
# AI_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Ask ARUVERSE generative model.
#
# THE LOCAL MODEL IS PRIMARY. It runs on ARUCAD's own GPU host (see
# deploy/ai/), so a student's question and their PersonalContext —
# department, year, their own appointments and clubs — are answered on
# campus and do not leave it.
#
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://10.0.0.12:8000/v1   # the private GPU host
# LOCAL_AI_MODEL=arucad-ask                    # vLLM served-model-name
#
# On a developer machine this is Ollama instead:
#
#   ollama create aicad-qwen3:8b -f deploy/ai/ollama/aicad-qwen3-8b.Modelfile
#   LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
#   LOCAL_AI_MODEL=aicad-qwen3:8b
#
# Use the aicad-* build, NOT a bare `qwen3:8b`. Ollama's default context is
# 4096 tokens and the system prompt alone measures ~6,200, so a bare pull
# silently drops the front of it — the language rule, the "never invent a
# number" rule and the prompt-injection fence — and still answers, plausibly
# and unguarded. The Modelfile exists to set num_ctx.
# LOCAL_AI_API_KEY=                            # same value as VLLM_API_KEY
# LOCAL_AI_TIMEOUT=60
# LOCAL_AI_TEMPERATURE=      # empty: use AI_TEMPERATURE
# LOCAL_AI_MAX_TOKENS=450     # empty: use AI_MAX_TOKENS
#   450 is chosen to match the 120-250 word answer the rules ask for. It was
#   600, and the model reached the ceiling on list-heavy questions every time
#   — 20s of generation ending mid-word. The provider now rolls a
#   length-truncated answer back to its last complete sentence, so the cap
#   degrades gracefully rather than cutting a word in half.
# LOCAL_AI_REASONING_EFFORT=none # Ollama Qwen: return the answer, not a hidden thinking trace
#
# PRIVACY — whether a question may ever be answered off campus.
#
# Both default to false, and BOTH must be true before Groq is reached at
# all: Ask is used by signed-in students, and a signed-in request counts
# as carrying personal data. With the local model down the request
# degrades to the knowledge-only answer (grounded, marked source-based)
# rather than being forwarded to a third party.
#
# Turning these on is a policy decision, which is why it takes two
# explicit variables instead of being a side effect of something else.
# AI_ALLOW_EXTERNAL_PROVIDERS=false
# AI_ALLOW_EXTERNAL_WITH_PERSONAL_DATA=false
# AI_FALLBACK_PROVIDER=groq   # only ever used if the two above allow it
#
# GENERATION. This is a grounded assistant, not a creative writer: the
# facts come from retrieval and the model phrases them. Low temperature
# keeps it from paraphrasing a fee or a date into something that was
# never in the source.
# AI_TEMPERATURE=0.2
# AI_MAX_TOKENS=800
#
# CONTEXT. The client sends the whole thread; the server decides how much
# of it the model sees, because only the server knows the model's window.
# Six turns is enough for a follow-up ("peki ücretler?") without dragging
# an hour-old topic into an unrelated question.
# AI_HISTORY_TURNS=12
#
# Context budget. The application decides what falls out of the window, not
# the runtime — left to itself every runtime drops the OLDEST tokens, which in
# this prompt are the rules. Set this to the model's context minus
# AI_MAX_TOKENS minus headroom (aicad-qwen3:8b: 12288 - 600 - ~700).
# AI_MAX_PROMPT_TOKENS=11000
#
# WHICH PERSONAL-DATA SYSTEMS ARE CONNECTED.
#
# All false: ARUCAD's SIS is not integrated with the assistant, so a student
# asking for their timetable, grades, advisor or balance is told exactly that,
# in their own language, and nothing is invented. Flip a flag to true ONLY
# when there is a real authenticated integration behind it — these are the
# assistant's statement about what it can see, and a true with nothing behind
# it is the system lying about itself.
# AI_CAPABILITY_TIMETABLE=false
# AI_CAPABILITY_GRADES=false
# AI_CAPABILITY_EXAMS=false
# AI_CAPABILITY_ATTENDANCE=false
# AI_CAPABILITY_ADVISOR=false
# AI_CAPABILITY_TRANSCRIPT=false
# AI_CAPABILITY_BALANCE=false
# AI_CAPABILITY_ENROLMENT=false
# AI_CAPABILITY_DISCIPLINE=false
# AI_CAPABILITY_LIBRARY_LOAN=false
# AI_CONTEXT_BUDGET_CHARS=6000
# ---------------------------------------------------------------------------

# Ask ARUVERSE cost controls. Defaults are the values in config/ai.php;
# these are here so they are discoverable, not because they must be set.
#
# AI_DIRECT_ANSWERS: answer campus lookups ("where is X", "what is on
# today", "canteen hours", "my next appointment") straight from our own
# tables, with no model call. Largest single reduction in model usage,
# and a looked-up fact cannot be hallucinated.
# AI_MAX_CONCURRENT: how many model calls may be in flight across the
# WHOLE campus. Past it, questions answer from indexed sources instead
# of queueing a PHP worker on a provider that serves a handful at a time.
# AI_DAILY_REQUESTS: the quota guard; 0 disables it.
# AI_DIRECT_ANSWERS=true
# AI_MAX_CONCURRENT=8
# AI_DAILY_REQUESTS=0
#
# AICAD rollout switches (docs/AICAD_KNOWLEDGE.md). false restores the
# previous behaviour without a code change.
# AICAD_TASK_PLANNING_ENABLED=true
# AICAD_EVIDENCE_ORCHESTRATION_ENABLED=true
# AICAD_EVIDENCE_BUDGET_CHARS=1200
# AICAD_SUPPORTED_FACT_GENERATION_ENABLED=off   # off | staff_only | on
# AICAD_CAMPUS_TIMEZONE=Europe/Nicosia

# Semantic search for Ask ARUVERSE, served by the moderation classifier
# already running for text moderation — same process, same weights, no
# second model and nothing leaving ARUCAD. Off (or classifier down) =
# keyword-only retrieval: worse answers, never an outage.
# After deploying, index what is already crawled once:
#   php artisan knowledge:embed --all
# KNOWLEDGE_EMBEDDINGS_ENABLED=true
# KNOWLEDGE_EMBEDDINGS_URL=http://127.0.0.1:8801

# Curated per-page keywords (knowledge:keywords:import). A keyword hit
# outranks a title hit but is weighted by how rare the keyword is, so a term
# authored on every page cannot lift anything.
# KNOWLEDGE_PAGE_KEYWORD_BONUS=5
# KNOWLEDGE_PAGE_KEYWORD_CAP=12

# Re-reading a curated page at question time. This is the only path where a
# student's question causes an outbound fetch to arucad.edu.tr, so the
# defaults are deliberately conservative; see deploy/ai/README.md.
# KNOWLEDGE_ON_DEMAND_ENABLED=true
# KNOWLEDGE_ON_DEMAND_MAX_PAGES=2
# KNOWLEDGE_ON_DEMAND_MAX_SPREAD=6
# KNOWLEDGE_ON_DEMAND_CACHE_MINUTES=60

# --- Live web research (AICAD reading the open web at question time) --------
# OFF by default. Without a key the assistant says it cannot search, which is
# a different answer from "I searched and found nothing" — and the student
# needs to know which one it was.
#
# Needs a Brave Search API key: https://brave.com/search/api/
# Nothing else about the feature is Brave-specific; see
# App\Services\Web\WebSearchProvider to swap in another provider.
#
# Only runs when ARUCAD's own indexed pages produced no source at all, so it
# is a fallback and not the default path. Official sources (arucad.edu.tr,
# .gov.tr, YÖK, universities) are read before anything else, every fetched
# page goes through the same prompt-injection scan and untrusted fence as
# crawled content, and every passage carries its URL.
# AI_WEB_SEARCH_ENABLED=false
# BRAVE_SEARCH_KEY=
# AI_WEB_MAX_PAGES=3
# AI_WEB_CHARS_PER_PAGE=1200
# AI_WEB_TIMEOUT=8
# AI_WEB_MAX_BYTES=2000000
# AI_WEB_CACHE_MINUTES=60
# KNOWLEDGE_MAX_PDF_BYTES=15000000
# KNOWLEDGE_MAX_PDF_CHARS=250000
# KNOWLEDGE_PDF_PARSER_MEMORY=192M
# KNOWLEDGE_PDF_PARSER_TIMEOUT=30
# SIS_PROVIDER=unavailable
# SIS_IDENTITY_FIELD=email
# SIS_CACHE_SECONDS=300

# ARUCAD-owned local image/video moderation executable. It must run on the
# same private host and emit the JSON contract documented in
# docs/LOCAL_MODERATION.md. No vendor key or public endpoint is used.
# Leave empty only while every upload is held for human review.
# LOCAL_MODERATION_BINARY=/opt/arucad/moderation/arucad-moderator
# LOCAL_MODERATION_BLOCK_THRESHOLD=0.92
# LOCAL_MODERATION_TIMEOUT_SECONDS=15

# A separate moderation gateway, never deployed. Kept off, and kept here
# only so nobody wonders where these keys went. The moderation the app
# actually runs is TEXT_MODERATION_* and IMAGE_MODERATION_* above, both
# served by the classifier on :8801.
MODERATION_SERVICE_ENABLED=false
MODERATION_SERVICE_URL=http://moderation:8080
MODERATION_SERVICE_TIMEOUT=15

# Media must not sit on the `public` disk: that directory is published by
# the public/storage symlink, which serves files without the moderation
# gate ever running.
FILESYSTEM_MEDIA_DISK=local

# Account consequences: strikes, suspensions, bans. Defaults to ON, and
# production must leave it that way. Set to false ONLY during a
# moderation testing window, when violations are being submitted on
# purpose and test accounts must not lock themselves out — content is
# still detected and refused either way, so a deployment left with this
# off looks entirely normal. Verify with:
#   GET /api/v1/health -> data.moderation.enforcement
# MODERATION_ENFORCEMENT_ENABLED=true

# Microsoft Entra (public client + PKCE). Empty = POST /auth/entra → 501.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_REDIRECT_URI=com.example.arucad_campus_prototype://oauthredirect
# ENTRA_VERIFY_SSL=

# OpenAI moderation (omni-moderation-latest — free, text + image).
#
# This is the first of two layers: the offline TextPolicyEngine runs
# alongside it and never depends on it. With no key, text is still fully
# enforced locally, but nothing can inspect a picture, so images and videos
# are held in the review queue rather than published unchecked.
#
# The name matters: config/services.php reads OPENAI_API_KEY. This file
# used to show OPENAI_MODERATION_API_KEY, so anyone copying the example got
# a key that was never read and silently no image moderation at all.
# OPENAI_API_KEY=

# Groq. NO LONGER THE PRIMARY for Ask — the local model is (see above).
# Still used for the poster→event draft (vision), which sends a staff-
# uploaded poster rather than student data. For Ask it is reached only
# when BOTH AI_ALLOW_EXTERNAL_* switches are true. Empty = 501.
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_VERIFY_SSL=  # empty: false in local, true elsewhere

