# Server-only ARUCAD 360° directory integration. Do not put this token in
# Flutter -- the backend sync command is the only caller of this API.
CAMPUS_DIRECTORY_BASE_URL=https://360.arucad.edu.tr
CAMPUS_DIRECTORY_API_KEY=
CAMPUS_DIRECTORY_ALLOWED_ORIGIN=https://360.arucad.edu.tr
CAMPUS_DIRECTORY_VERIFY_SSL=true
# Required — the real staging web origin(s), comma-separated if more than
# one (e.g. web app + admin panel). Boot fails if this is left empty or set
# to "*" (P3-7 §18).
# CORS_ALLOWED_ORIGINS=https://staging-app.example.com
# Only if staging sits behind a reverse proxy/load balancer; leave unset
# otherwise.
# TRUSTED_PROXIES=
# ---------------------------------------------------------------------------
# Production (copy to the production host .env — never commit real secrets)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# FILESYSTEM_MEDIA_DISK=public
# MEDIA_URL=https://api.example.com
# BROADCAST_CONNECTION=reverb
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=
# FCM_REQUIRED=true
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# Required — the real production web origin(s), comma-separated if more than
# one. Boot fails if this is left empty or set to "*" (P3-7 §18).
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Only if production sits behind a reverse proxy/load balancer; leave unset
# otherwise.
# TRUSTED_PROXIES=

# OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_OPENAI_ENABLED=true
MODERATION_FAIL_CLOSED=true
# Optional HIGH-confidence overrides. Lower/medium scores never auto-block.
# MODERATION_T_SEXUAL_MINORS=0.90
# MODERATION_T_HARASSMENT_THREAT=0.85
# MODERATION_T_HATE_THREAT=0.85
# MODERATION_T_VIOLENCE_GRAPHIC=0.90
# MODERATION_T_SELF_HARM_INSTR=0.90
# MODERATION_T_SELF_HARM_INTENT=0.90
# MODERATION_T_SEXUAL=0.90
# MODERATION_T_HATE=0.85
# MODERATION_T_HARASSMENT=0.90
# MODERATION_T_VIOLENCE=0.90
# MODERATION_T_SELF_HARM=0.90
# MODERATION_T_ILLICIT=0.90
# MODERATION_T_ILLICIT_VIOLENT=0.90
