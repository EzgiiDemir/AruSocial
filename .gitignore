# Root .gitignore — covers all three project folders (frontend/, backend/,
# sql/) plus this machine's own local tooling overrides. See docs/README.md
# for the folder layout this maps to.

# --- Flutter (frontend/) ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
build/
*.iml
# Android SDK path is machine-specific — never commit it.
local.properties
# Gradle's own build cache/lock files — pure local state, never commit.
.gradle/

# --- Laravel (backend/) ---
# backend/.gitignore already covers vendor/, .env, storage caches, etc.

# --- SQLite dev database (sql/) ---
# Runtime data, not source — see sql/README.md for how to recreate it.
sql/database.sqlite
sql/database.sqlite-*
# `-*` catches the WAL/SHM siblings but not `database.sqlite.backup-<date>`,
# which is a full copy of live student data.
sql/database.sqlite.*
# Timestamped copies taken before a `migrate:fresh` — same runtime data,
# just older, so they don't belong in source control either.
sql/backups/

# --- Editors / IDEs ---
.idea/
.vscode/

# --- This machine's local PHP extension override ---
# fileinfo/pdo_sqlite/sqlite3 enabled here because this machine's system
# php.ini doesn't have them and isn't writable without admin rights —
# machine-specific, not project config. See backend/README.md.
.phpconfig/

# Firebase / FCM — never commit real project files or generated options.
frontend/android/app/google-services.json
frontend/ios/Runner/GoogleService-Info.plist
frontend/lib/firebase_options.dart
backend/.env


# Dart/Flutter tool scratch dirs created when APPDATA/LOCALAPPDATA are
# redirected into the repo on this machine — build output, never source.
.dart_appdata/
.dart_localappdata/

# --- Python moderation gateway ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Vendored binaries and build output, never source ---
#
# `git add -A` was about to commit 592 MB of these: a 483 MB unpacked
# ffmpeg distribution, Flutter's widget-preview cache, and the Node
# packages for the moderation helper. None of it is authored here and all
# of it is reproducible from a lock file or a download.
node_modules/
package-lock.json
tools/ffmpeg-*/
tools/ffmpeg*.zip
frontend/.widget_preview/
