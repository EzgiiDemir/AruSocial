<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Raised from PHP's 128M default when Filament arrived: it adds
            ~109 packages to the autoloader, and PHPUnit runs the whole
            suite in one process, so the run began dying part-way through
            with "Premature end of PHP process" — a segfault, not a test
            failure, and one that moved around depending on ordering.

            Set here rather than in the machine's php.ini so it applies to
            this suite only and travels with the repository.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="GROQ_API_KEY" value="" force="true"/>
        <!--
            The visual classifier is off by default in tests, and forced so
            a developer's local .env cannot switch it on. It is a real HTTP
            service: left enabled, every upload test in the suite would try
            to reach it, correctly fail closed, and return 503 — turning a
            working safety guarantee into a hundred confusing failures.

            Tests that exercise image moderation enable it themselves and
            fake the transport (see ImageModerationSafetyTest).
        -->
        <env name="IMAGE_MODERATION_ENABLED" value="false" force="true"/>
        <!--
            Live web research off, and the key blanked, for the same reason
            as GROQ_API_KEY above: a real .env must not change what the suite
            measures. Three tests inspecting the outgoing model request began
            failing when a developer's Tavily key made the assistant search
            the web mid-test. WebResearchTest turns it on explicitly.
        -->
        <env name="AI_WEB_SEARCH_ENABLED" value="false" force="true"/>
        <env name="TAVILY_API_KEY" value="" force="true"/>
        <env name="BRAVE_SEARCH_KEY" value="" force="true"/>
        <!--
            The test suite must never call the real moderation API: it would
            be slow, non-deterministic, and would spend a live quota. Tests
            therefore run on the local engine by default; the ones that
            exercise the OpenAI path set the key themselves and fake HTTP.
        -->
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="MODERATION_OPENAI_ENABLED" value="true" force="true"/>
        <env name="MODERATION_SERVICE_ENABLED" value="false" force="true"/>
        <!-- The semantic text layer talks to a locally running service.
             Forced off so the suite never depends on whether that process
             happens to be up, and so a test asserting lexicon behaviour is
             actually asserting lexicon behaviour. Tests that want it enable
             it in-test with Http::fake. -->
        <env name="TEXT_MODERATION_ENABLED" value="false" force="true"/>
        <!--
            Retrieval embeddings are served by the same classifier as text
            moderation, so they are off here for the same reason: the suite
            must not depend on a service being up, and Http::preventStrayRequests
            turns an unfaked call into a failure. Tests that exercise semantic
            retrieval switch it on and fake the response.
        -->
        <env name="KNOWLEDGE_EMBEDDINGS_ENABLED" value="false" force="true"/>
        <!-- Forced on so the suite always asserts production enforcement,
             whatever a developer has switched off locally during a
             moderation testing window. A test that silently adopts the
             local .env stops being a regression net for the thing it
             covers; a test needing it off sets the config in-test. -->
        <env name="MODERATION_ENFORCEMENT_ENABLED" value="true" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
