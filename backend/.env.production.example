# ARUVERSE — production environment template.
#
# Copy to `.env` ON THE SERVER and fill every empty value. Never commit the
# filled file; `.gitignore` already excludes `.env`, and this template is the
# only version that belongs in git.
#
# `App\Support\EnvironmentGuard` refuses to boot with local-looking values
# (SQLite, APP_DEBUG=true, a localhost APP_URL, empty or wildcard CORS), so a
# half-filled file fails fast at deploy time instead of serving insecurely.
#
# Values left blank below are genuinely unknown to this repository — see the
# "Pending information" section of docs/DEPLOYMENT_ARUVERSE.md.

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=ARUVERSE
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# The API's own public origin. Used to build absolute URLs (media, signed
# links) and, via TrustHosts, to reject requests with a foreign Host header.
APP_URL=https://api-aruverse.arucad.edu.tr
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────────
# Must NOT be reachable from the internet. Bind Postgres to the private
# interface (or localhost when it runs on the same host) and let the firewall
# refuse 5432 from outside.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=aruverse
# Least privilege: this account owns the application schema and nothing else.
# It must not be the Postgres superuser and must not have CREATEDB/CREATEROLE.
#   CREATE ROLE aruverse_app LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE aruverse TO aruverse_app;
#   GRANT USAGE, CREATE ON SCHEMA public TO aruverse_app;  -- CREATE: migrations
# Backups use a separate read-only role; see deploy/scripts/pg_backup.sh.
DB_USERNAME=aruverse_app
DB_PASSWORD=

# ── Sessions / cookies (the Filament admin panel) ────────────────────────
# The JSON API authenticates with Sanctum bearer tokens and sends no cookie.
# These settings exist for the admin panel, which is a normal session login.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Host-only cookie: leaving this blank scopes the session to
# admin-aruverse.arucad.edu.tr exactly. Do NOT set `.arucad.edu.tr` — that
# would send the admin session cookie to every university subdomain.
SESSION_DOMAIN=
# HTTPS-only. Both are non-negotiable in production.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# `lax` keeps the cookie on normal top-level navigation to the panel while
# withholding it from cross-site POSTs. Filament also carries Laravel's CSRF
# token (PreventRequestForgery), so this is defence in depth, not the only
# protection.
SESSION_SAME_SITE=lax

# ── CORS ─────────────────────────────────────────────────────────────────
# Exactly the two browser origins that may call this API. No wildcard: the
# guard rejects "*" outright. Native mobile clients send no Origin header and
# are unaffected by this list.
CORS_ALLOWED_ORIGINS=https://app-aruverse.arucad.edu.tr,https://admin-aruverse.arucad.edu.tr

# nginx terminates TLS and sets X-Forwarded-*. Laravel must trust it or every
# request looks like plain HTTP from the proxy's IP (breaking rate limiting
# by IP, secure-cookie issuance and generated URLs). "*" is correct when the
# app is only ever reachable through that proxy; narrow it to the proxy's IP
# if the PHP port is exposed on a shared network.
TRUSTED_PROXIES=*

# Only institutional accounts may sign in.
AUTH_ALLOWED_EMAIL_DOMAINS=arucad.edu.tr

# ── Queue / cache ────────────────────────────────────────────────────────
# `sync` is rejected in production: moderation and email would run inside the
# web request. A worker must be running (see the deployment doc).
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Realtime (Reverb) ────────────────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=api-aruverse.arucad.edu.tr
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
BROADCAST_CONNECTION=reverb

# ── Mail (ARUCAD institutional SMTP — Microsoft 365) ─────────────────────
# These are the ARUCAD mail-server settings (same as apply.arucad.edu.tr's
# WP Mail SMTP config). Office 365 is Microsoft-hosted but it is ARUCAD's own
# institutional mailbox — not a transactional email SaaS.
#
# MAIL_PASSWORD is a SECRET: set it directly in the server's real .env (or a
# secrets manager). NEVER commit it and never put it in this example file.
# Note: O365 requires SMTP AUTH to be enabled for this mailbox, and if the
# tenant enforces MFA, an app password (or a mail-enabled service account) is
# needed for SMTP.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=support@arucad.edu.tr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@arucad.edu.tr
MAIL_FROM_NAME=ARUVERSE

# ── Integrations ─────────────────────────────────────────────────────────
# Every key below is server-side only and never reaches a client. The admin
# panel's Integrations page shows these as masked tails, never values.
# Leaving one blank is supported: that integration reports "Not Configured"
# and the feature degrades honestly rather than failing at runtime.

# ARUCAD 360 campus directory (supplied by ARUCAD IT).
CAMPUS_DIRECTORY_BASE_URL=https://360.arucad.edu.tr
CAMPUS_DIRECTORY_API_KEY=
CAMPUS_DIRECTORY_ALLOWED_ORIGIN=https://360.arucad.edu.tr

# Ask ARUVERSE assistant — AI provider strategy.
# Groq is the PRIMARY provider. Local AI is an OPTIONAL fallback and is NOT
# required: leave LOCAL_AI_* empty and ARUVERSE runs fully on Groq. Set the
# local endpoint later to enable "Groq primary + Local AI fallback".
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=local
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# gpt-oss/qwen are reasoning models — hide their chain-of-thought so only the
# clean final answer is returned (otherwise the model's 'thinking' leaks into chat).
GROQ_REASONING_FORMAT=hidden
GROQ_REASONING_EFFORT=low
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_RATE_LIMIT_PER_MINUTE=20

# Campus-wide ceiling on model calls (see config/ai.php).
#
# The per-user limit (AI_RATE_LIMIT_PER_MINUTE) bounds one student and
# says nothing about three thousand together. AI_MAX_CONCURRENT is what
# stops a lecture ending from queueing hundreds of PHP workers on a
# provider that answers a handful at a time; AI_DAILY_REQUESTS keeps a
# free tier alive past mid-morning. Exceeding either degrades to
# knowledge-only answers, never an error. 0 disables the daily cap.
AI_BUDGET_ENABLED=true
AI_MAX_CONCURRENT=8
AI_DAILY_REQUESTS=0

# Semantic search for Ask ARUVERSE, served by the moderation classifier
# (same process, same weights, no extra model). Off = keyword-only
# retrieval, which is a quality loss and not an outage.
KNOWLEDGE_EMBEDDINGS_ENABLED=true
KNOWLEDGE_EMBEDDINGS_URL=http://127.0.0.1:8801
KNOWLEDGE_MAX_PDF_BYTES=15000000
KNOWLEDGE_MAX_PDF_CHARS=250000
KNOWLEDGE_PDF_PARSER_MEMORY=192M
KNOWLEDGE_PDF_PARSER_TIMEOUT=30

# Keep disabled until IT supplies an approved read-only SIS integration.
SIS_PROVIDER=unavailable
SIS_IDENTITY_FIELD=email
SIS_CACHE_SECONDS=300

# Quota/usage controls.
AI_RETRIES=1
AI_CONTEXT_BUDGET_CHARS=6000
AI_CACHE_ENABLED=true
AI_CACHE_TTL_MINUTES=360

# Resilience: circuit breaker + knowledge-only degraded mode. When Groq is
# quota-exhausted / rate-limited / down, the breaker opens for a cooldown so we
# stop hammering it; if no AI provider can serve, ARUVERSE still answers from
# Site Knowledge + internal data (grounded, marked as source-based).
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=120
AI_CIRCUIT_QUOTA_COOLDOWN_SECONDS=900
AI_ALLOW_KNOWLEDGE_ONLY_FALLBACK=true

# Optional self-hosted fallback (Ollama/vLLM). Leave empty unless/until a
# local model is running — a missing endpoint is never an error.
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_AI_MODEL=llama3.1

# Microsoft Entra sign-in. These are public client identifiers, not secrets;
# they may also be set from the admin panel, which takes precedence.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REDIRECT_URI=https://app-aruverse.arucad.edu.tr/auth/callback

# Walking directions. Blank = the API answers 501 instead of inventing a route.
ROUTING_BASE_URL=

# Push notifications. Blank = inbox-only delivery, which is a supported mode.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_REQUIRED=false

# Content moderation.
# Self-hosted by default. MODERATION_OPENAI_ENABLED=true sends student
# content to a third party and CONTRADICTS the published privacy notice —
# do not enable it without updating that notice first.
MODERATION_OPENAI_ENABLED=false
OPENAI_API_KEY=
MODERATION_FAIL_CLOSED=true
LOCAL_MODERATION_BINARY=

# Error reporting. Blank = disabled silently.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
